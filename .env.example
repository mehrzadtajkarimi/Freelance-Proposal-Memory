APP_NAME="Freelance Proposal Memory"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8084
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=freelance_proposal_memory
