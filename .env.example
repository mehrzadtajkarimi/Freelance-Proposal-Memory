DB_PASSWORD=CHANGE_ME_TO_A_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_ANOTHER_RANDOM_PASSWORD

APP_PORT=8084
DB_FORWARD_PORT=94
REDIS_FORWARD_PORT=6381
PHPMYADMIN_PORT=8095
